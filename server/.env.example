# Local development values for the Spring Boot server. Copy to server/.env (gitignored):
#   cp server/.env.example server/.env
# These values work as-is with `docker compose up -d db`. Never put real credentials here.

# Database (PostgreSQL from docker-compose.yml)
DB_URL=jdbc:postgresql://localhost:5432/justina
DB_DRIVER_CLASS_NAME=org.postgresql.Driver
DB_USER=justina
DB_PASSWORD=justina
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# JWT signing key: Base64 of at least 32 bytes. Local-only value.
SECRET=bG9jYWwtZGV2LW9ubHktand0LXNlY3JldC1kby1ub3QtdXNlLWluLXByb2QtMDEyMzQ1Njc4OQ==

# Email (Gmail SMTP). Dummy values: the app starts, sending emails fails.
MAIL_PORT=587
MAIL_USER=dev@example.com
MAIL_PASSWORD=change-me

# Cloudinary (image uploads). Dummy values: the app starts, uploads fail.
CLOUDINARY_NAME=local-dev
CLOUDINARY_API_KEY=local-dev
CLOUDINARY_API_SECRET=local-dev
